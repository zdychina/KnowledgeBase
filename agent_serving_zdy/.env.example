# ── PostgreSQL (外部独立部署) ──────────────────────────────────────────────────
PG_HOST=your-postgres-host
PG_PORT=5432
PG_DBNAME=coremasterkb
PG_USER=zdy
PG_PASSWORD=your-password
PG_POOL_MIN=2
PG_POOL_MAX=10

# ── Per-domain DB URLs ────────────────────────────────────────────────────────
# Key 名来自 domain_registry.yaml → database_url_env 字段
COREMASTERKB_DB_CLOUD_CORE=jdbc:postgresql://your-postgres-host:5432/coremasterkb
COREMASTERKB_DB_GENERIC=jdbc:postgresql://your-postgres-host:5432/coremasterkb

# ── Config source ────────────────────────────────────────────────────────────
# Serving pulls per-domain config (registry + scenario serving block + inline DB)
# from main_control over HTTP. The PG_* / COREMASTERKB_DB_* below are only the
# default datasource + local-file fallback when main_control is unreachable.
SERVING_MAIN_CONTROL_BASEURL=http://localhost:8910

# ── LLM / Embedding / Rerank ─────────────────────────────────────────────────
LLM_SERVICE_URL=http://your-llm-host:8900
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=rerank-pro
